    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'anzen2'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=anzen2"
                ],
                "filter": {
                    "name": "anzen2",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'http_server'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=http_server",
                    "--package=anzen2"
                ],
                "filter": {
                    "name": "http_server",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "BIND_LOCALHOST_ADDR": "false"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'http_server'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=http_server",
                    "--package=anzen2"
                ],
                "filter": {
                    "name": "http_server",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}